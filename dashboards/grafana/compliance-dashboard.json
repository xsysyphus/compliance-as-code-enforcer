{
  "uid": "compliance-runtime",
  "title": "Compliance Runtime - SOC2",
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "editable": true,
  "refresh": "5m",
  "time": {
    "from": "now-7d",
    "to": "now"
  },
  "templating": {
    "list": [
      {
        "name": "region",
        "type": "custom",
        "query": "us-east-1,us-west-2,eu-west-1",
        "current": {
          "text": "us-east-1",
          "value": "us-east-1",
          "selected": true
        },
        "label": "AWS Region"
      },
      {
        "name": "logGroup",
        "type": "custom",
        "query": "/aws/lambda/compliance-as-code-prod-scanner,/aws/lambda/compliance-as-code-shared-scanner",
        "current": {
          "text": "/aws/lambda/compliance-as-code-prod-scanner",
          "value": "/aws/lambda/compliance-as-code-prod-scanner",
          "selected": true
        },
        "label": "Log Group"
      }
    ]
  },
  "panels": [
    {
      "type": "stat",
      "title": "Compliance Score",
      "id": 1,
      "gridPos": { "h": 6, "w": 6, "x": 0, "y": 0 },
      "datasource": { "type": "cloudwatch", "uid": "cloudwatch" },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "orientation": "horizontal",
        "colorMode": "value",
        "graphMode": "area",
        "justifyMode": "center",
        "thresholds": {
          "mode": "absolute",
          "steps": [
            { "color": "red", "value": null },
            { "color": "orange", "value": 70 },
            { "color": "green", "value": 90 }
          ]
        },
        "fieldOptions": {
          "defaults": { "unit": "percent" },
          "overrides": []
        }
      },
      "targets": [
        {
          "refId": "score",
          "expression": "100*(m1-m2)/m1",
          "label": "ComplianceScore",
          "region": "$region"
        },
        {
          "refId": "m1",
          "namespace": "Compliance/Runtime",
          "metricName": "Resources",
          "statistic": "Average",
          "period": "300",
          "region": "$region"
        },
        {
          "refId": "m2",
          "namespace": "Compliance/Runtime",
          "metricName": "Failures",
          "statistic": "Average",
          "period": "300",
          "region": "$region"
        }
      ]
    },
    {
      "type": "stat",
      "title": "Critical Violations (last run)",
      "id": 2,
      "gridPos": { "h": 6, "w": 6, "x": 6, "y": 0 },
      "datasource": { "type": "cloudwatch", "uid": "cloudwatch" },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "orientation": "horizontal",
        "colorMode": "value",
        "graphMode": "none",
        "thresholds": {
          "mode": "absolute",
          "steps": [
            { "color": "green", "value": null },
            { "color": "orange", "value": 1 }
          ]
        }
      },
      "targets": [
        {
          "refId": "A",
          "namespace": "Compliance/Runtime",
          "metricName": "Critical",
          "statistic": "Maximum",
          "period": "300",
          "region": "$region"
        }
      ]
    },
    {
      "type": "stat",
      "title": "Failures (last run)",
      "id": 3,
      "gridPos": { "h": 6, "w": 6, "x": 12, "y": 0 },
      "datasource": { "type": "cloudwatch", "uid": "cloudwatch" },
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "orientation": "horizontal",
        "colorMode": "value",
        "graphMode": "none",
        "thresholds": {
          "mode": "absolute",
          "steps": [
            { "color": "green", "value": null },
            { "color": "yellow", "value": 1 },
            { "color": "red", "value": 5 }
          ]
        }
      },
      "targets": [
        {
          "refId": "A",
          "namespace": "Compliance/Runtime",
          "metricName": "Failures",
          "statistic": "Maximum",
          "period": "300",
          "region": "$region"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Critical Violations Trend",
      "id": 4,
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 6 },
      "datasource": { "type": "cloudwatch", "uid": "cloudwatch" },
      "fieldConfig": {
        "defaults": { "color": { "mode": "palette-classic" } },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "namespace": "Compliance/Runtime",
          "metricName": "Critical",
          "statistic": "Sum",
          "period": "300",
          "region": "$region"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Resources vs Failures",
      "id": 5,
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 6 },
      "datasource": { "type": "cloudwatch", "uid": "cloudwatch" },
      "targets": [
        {
          "refId": "A",
          "namespace": "Compliance/Runtime",
          "metricName": "Resources",
          "statistic": "Average",
          "period": "300",
          "region": "$region"
        },
        {
          "refId": "B",
          "namespace": "Compliance/Runtime",
          "metricName": "Failures",
          "statistic": "Average",
          "period": "300",
          "region": "$region"
        }
      ]
    },
    {
      "type": "table",
      "title": "Últimas Execuções (CloudWatch Logs Insights)",
      "id": 6,
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 14 },
      "datasource": { "type": "cloudwatch", "uid": "cloudwatch" },
      "options": {
        "showHeader": true,
        "footer": {
          "show": false
        }
      },
      "targets": [
        {
          "refId": "A",
          "queryMode": "Logs",
          "region": "$region",
          "logGroupNames": ["$logGroup"],
          "expression": "fields @timestamp, run_id, resources, failures, critical | filter event = \"compliance_scan_summary\" | sort @timestamp desc | limit 20"
        }
      ],
      "transformations": [
        {
          "id": "renameByRegex",
          "options": {
            "regex": "(@timestamp)",
            "renamePattern": "timestamp"
          }
        }
      ]
    }
  ],
  "annotations": {
    "list": [
      {
        "builtIn": 1,
        "datasource": { "type": "grafana", "uid": "-- Grafana --" },
        "enable": true,
        "hide": true,
        "iconColor": "rgba(0, 211, 255, 1)",
        "name": "Annotations & Alerts",
        "type": "dashboard"
      }
    ]
  }
}
